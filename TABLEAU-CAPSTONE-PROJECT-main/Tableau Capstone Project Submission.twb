      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_1229426150739970]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Average Order Value' datatype='real' datatype-customized='true' default-format='c&quot;₹&quot;#,##0,.00K;(&quot;₹&quot;#,##0,.00K)' name='[Calculation_1229426157846533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='Sales Per Customer' datatype='real' default-format='c&quot;₹&quot;#,##0,.00K;(&quot;₹&quot;#,##0,.00K)' name='[Calculation_1229426158092294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer ID])' />
      </column>
      <column caption='Revenue Per Unit' datatype='real' name='[Calculation_1229426158252039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / SUM([Quantity])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1229426158391304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &quot;18–24&quot;&#10;ELSEIF [Age] &lt; 35 THEN &quot;25–34&quot;&#10;ELSEIF [Age] &lt; 45 THEN &quot;35–44&quot;&#10;ELSEIF [Age] &lt; 55 THEN &quot;45–54&quot;&#10;ELSE &quot;55+&quot;&#10;END' />
      </column>
